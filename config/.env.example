# Copia este archivo como config/.env y rellena los valores.
# config/.env NUNCA se sube a GitHub (esta en .gitignore).

# --- OBLIGATORIO: al menos uno de los dos (generacion de guiones) ---
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- MUY RECOMENDADO: b-roll, musica y efectos de sonido ---
PIXABAY_API_KEY=

# --- OPCIONAL: escenarios propios en la nube (FLUX). No hace falta si usamos GPU local ---
HF_TOKEN=

# --- OPCIONAL: inteligencia viral (scraping Instagram). Solo se usa los lunes ---
APIFY_TOKEN=

# --- OPCIONAL: imagenes de pago ---
REPLICATE_API_TOKEN=
ELEVENLABS_API_KEY=

# --- OPCIONAL: panel publico y estado en Cloudflare R2 ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=
R2_STATE_BUCKET=

# --- OPCIONAL: publicacion en Meta (Fase 5, todavia no) ---
META_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=

# --- OPCIONAL: avisos ---
TELEGRAM_WEBHOOK_URL=
